{
  "installCommand": "npm ci --prefix pickleball-react && npm ci",
  "buildCommand": "bash -c 'cd pickleball-react && npm run build'",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/pickleball-react/dist/assets/:path*"
    },
    {
      "source": "/simple",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/pickleball-react/dist/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/pickleball-react/dist/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pickleball-react/dist/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

